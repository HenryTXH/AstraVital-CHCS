<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AstraVital | Crew Health & Care System (CHCS)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        space: {
                            950: '#061322',
                            900: '#09172b',
                            800: '#102b43',
                            700: '#193959',
                            600: '#2e526c',
                        },
                        cyan: {
                            accent: '#56e0ea',
                            glow: '#69e5ec',
                        },
                        amber: {
                            warning: '#f2bd62',
                        },
                        emerald: {
                            success: '#51e0aa',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-space-950 text-slate-100 min-h-screen font-sans selection:bg-cyan-accent selection:text-space-950">

    <!-- Header / Top Navigation -->
    <header class="bg-space-900 border-b border-space-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-accent to-space-600 flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6 text-space-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black tracking-wider text-white">ASTRAVITAL</h1>
                    <p class="text-xs text-cyan-accent font-medium tracking-wide">CREW HEALTH & CARE SYSTEM (CHCS)</p>
                </div>
            </div>
            
            <!-- Mission UTC Clock & Badge -->
            <div class="flex items-center space-x-4">
                <div class="hidden md:block text-right">
                    <div class="text-xs uppercase text-slate-400 font-semibold tracking-wider">Mission UTC Time</div>
                    <div id="utc-clock" class="text-lg font-mono font-bold text-cyan-accent">00:00:00 UTC</div>
                </div>
                <div class="px-3 py-1.5 rounded-lg bg-space-800 border border-space-600 text-xs font-mono text-amber-warning flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-amber-warning animate-pulse"></span>
                    <span>OFFLINE EDGE MODE</span>
                </div>
            </div>
        </div>
        <!-- Development Build Warning Banner -->
        <div class="bg-amber-warning/10 border-t border-amber-warning/30 px-4 py-2 text-center text-xs text-amber-warning font-medium">
            ⚠️ DEVELOPMENT BUILD SYNTHETIC DATA ONLY — Not a medical device or diagnostic system. Offline edge compute active.
        </div>
    </header>

    <!-- Main Workspace Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Grid Layout for Dashboard Sections -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <!-- Left Column: Section 01 / Crew Identity & Daily Self-Check (7 Cols) -->
            <section class="lg:col-span-7 bg-space-900 border border-space-700 rounded-2xl p-6 shadow-xl space-y-6">
                <div class="flex items-center justify-between border-b border-space-700 pb-4">
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-cyan-accent/20 text-cyan-accent font-bold">01</span>
                        <h2 class="text-lg font-bold text-white tracking-wide">CREW IDENTITY & DAILY SELF-CHECK</h2>
                    </div>
                    <span class="text-xs text-slate-400 font-mono">SECURE OFFLINE KIOSK</span>
                </div>

                <form id="checkin-form" class="space-y-5" onsubmit="event.preventDefault(); submitCheckin();">
                    <!-- Roster ID Selector -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-2">Select Roster ID / Crew Member</label>
                        <select id="roster-id" class="w-full bg-space-800 border border-space-600 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-cyan-accent transition">
                            <option value="ASTRO_01_KALEB">Kaleb Vance (Commander) - ASTRO_01_KALEB</option>
                            <option value="ASTRO_02_ELENA">Elena Rostova (Mission Specialist) - ASTRO_02_ELENA</option>
                            <option value="ASTRO_03_TARIQ">Tariq Al-Hassan (Flight Engineer) - ASTRO_03_TARIQ</option>
                            <option value="ASTRO_04_MEI">Mei-Ling Zhou (Payload Specialist) - ASTRO_04_MEI</option>
                            <option value="ASTRO_05_ZACK">Zack Taylor (Systems Specialist) - ASTRO_05_ZACK</option>
                        </select>
                    </div>

                    <!-- Sleep Hours Input -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-300 mb-2">Sleep During Last Rest Period (Hours)</label>
                            <input type="number" id="sleep-hours" min="0" max="24" step="0.5" value="7.5" class="w-full bg-space-800 border border-space-600 rounded-xl px-4 py-3 text-slate-100 font-mono focus:outline-none focus:border-cyan-accent transition">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-300 mb-2">Self-Rated Fatigue (1 Low - 5 High)</label>
                            <select id="fatigue-rating" class="w-full bg-space-800 border border-space-600 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-cyan-accent transition">
                                <option value="1">1 - Minimal Fatigue / Alert</option>
                                <option value="2" selected>2 - Mild Fatigue</option>
                                <option value="3">3 - Moderate Fatigue</option>
                                <option value="4">4 - High Fatigue</option>
                                <option value="5">5 - Severe Exhaustion</option>
                            </select>
                        </div>
                    </div>

                    <!-- Wellbeing Rating (1-5) -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-2">How would you rate your wellbeing today? (Self-reported)</label>
                        <div class="grid grid-cols-5 gap-3">
                            <label class="cursor-pointer bg-space-800 border border-space-600 rounded-xl p-3 text-center hover:border-cyan-accent transition flex flex-col items-center">
                                <input type="radio" name="wellbeing" value="1" class="mb-1 text-cyan-accent focus:ring-cyan-accent">
                                <span class="text-xs font-semibold text-red-400">1 (Red)</span>
                            </label>
                            <label class="cursor-pointer bg-space-800 border border-space-600 rounded-xl p-3 text-center hover:border-cyan-accent transition flex flex-col items-center">
                                <input type="radio" name="wellbeing" value="2" class="mb-1 text-cyan-accent focus:ring-cyan-accent">
                                <span class="text-xs font-semibold text-red-400">2 (Red)</span>
                            </label>
                            <label class="cursor-pointer bg-space-800 border border-space-600 rounded-xl p-3 text-center hover:border-cyan-accent transition flex flex-col items-center">
                                <input type="radio" name="wellbeing" value="3" class="mb-1 text-cyan-accent focus:ring-cyan-accent">
                                <span class="text-xs font-semibold text-amber-warning">3 (Amber)</span>
                            </label>
                            <label class="cursor-pointer bg-space-800 border border-space-600 rounded-xl p-3 text-center hover:border-cyan-accent transition flex flex-col items-center">
                                <input type="radio" name="wellbeing" value="4" class="mb-1 text-cyan-accent focus:ring-cyan-accent">
                                <span class="text-xs font-semibold text-emerald-success">4 (Green)</span>
                            </label>
                            <label class="cursor-pointer bg-space-800 border border-space-600 rounded-xl p-3 text-center hover:border-cyan-accent transition flex flex-col items-center">
                                <input type="radio" name="wellbeing" value="5" checked class="mb-1 text-cyan-accent focus:ring-cyan-accent">
                                <span class="text-xs font-semibold text-emerald-success">5 (Green)</span>
                            </label>
                        </div>
                    </div>

                    <!-- Optional Context Notes -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-300 mb-2">Optional Context / Note for Personal Review</label>
                        <textarea id="checkin-notes" rows="2" placeholder="Short note for your own review (Not transmitted immediately)..." class="w-full bg-space-800 border border-space-600 rounded-xl px-4 py-3 text-slate-100 text-sm focus:outline-none focus:border-cyan-accent transition"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full bg-gradient-to-r from-cyan-accent to-blue-600 text-space-950 font-bold py-3.5 px-6 rounded-xl shadow-lg hover:opacity-95 transition transform active:scale-95 flex items-center justify-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span>Complete Today's Check-In</span>
                    </button>
                </form>
            </section>

            <!-- Right Column: Section 02 / Today at a Glance (5 Cols) -->
            <section class="lg:col-span-5 space-y-6">
                <div class="bg-space-900 border border-space-700 rounded-2xl p-6 shadow-xl space-y-6">
                    <div class="flex items-center justify-between border-b border-space-700 pb-4">
                        <div class="flex items-center space-x-2">
                            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-cyan-accent/20 text-cyan-accent font-bold">02</span>
                            <h2 class="text-lg font-bold text-white tracking-wide">TODAY AT A GLANCE</h2>
                        </div>
                        <span class="text-xs text-slate-400 font-mono">STATUS SUMMARY</span>
                    </div>

                    <!-- Live Status Summary Card -->
                    <div id="status-card" class="rounded-xl p-5 border transition-all duration-300 bg-space-800/80 border-space-600">
                        <div class="flex items-center space-x-3">
                            <div id="status-indicator" class="w-3.5 h-3.5 rounded-full bg-amber-warning animate-pulse"></div>
                            <div>
                                <div class="text-xs uppercase font-mono text-slate-400">Operational Status</div>
                                <div id="status-text" class="text-xl font-black text-amber-warning tracking-wide">DATA INCOMPLETE</div>
                            </div>
                        </div>
                        <p id="status-desc" class="text-xs text-slate-300 mt-3">Complete the daily self-check form on the left to finalize your check-in record.</p>
                    </div>

                    <!-- Metric Summaries Grid -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-space-800 border border-space-700 rounded-xl p-4">
                            <div class="text-xs text-slate-400 font-medium">Sleep Recorded</div>
                            <div id="summary-sleep" class="text-xl font-bold font-mono text-white mt-1">-- hrs</div>
                        </div>
                        <div class="bg-space-800 border border-space-700 rounded-xl p-4">
                            <div class="text-xs text-slate-400 font-medium">Fatigue Level</div>
                            <div id="summary-fatigue" class="text-xl font-bold font-mono text-white mt-1">-- / 5</div>
                        </div>
                        <div class="bg-space-800 border border-space-700 rounded-xl p-4">
                            <div class="text-xs text-slate-400 font-medium">Wellbeing Score</div>
                            <div id="summary-wellbeing" class="text-xl font-bold font-mono text-white mt-1">-- / 5</div>
                        </div>
                        <div class="bg-space-800 border border-space-700 rounded-xl p-4">
                            <div class="text-xs text-slate-400 font-medium">Wearable File</div>
                            <div id="summary-wearable" class="text-sm font-bold font-mono text-cyan-accent mt-1 truncate">None Loaded</div>
                        </div>
                    </div>
                </div>
            </section>

        </div>

        <!-- Section 03 / Wearable Data (Full Width) -->
        <section class="bg-space-900 border border-space-700 rounded-2xl p-6 shadow-xl space-y-6">
            <div class="flex items-center justify-between border-b border-space-700 pb-4">
                <div class="flex items-center space-x-2">
                    <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-cyan-accent/20 text-cyan-accent font-bold">03</span>
                    <h2 class="text-lg font-bold text-white tracking-wide">WEARABLE DATA & LOCAL CSV PROCESSOR</h2>
                </div>
                <span class="text-xs text-slate-400 font-mono">OFFLINE PARSER</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div class="md:col-span-7 space-y-4">
                    <label class="block text-sm font-semibold text-slate-300">Load a Crew Wearable Record (CSV)</label>
                    <div class="flex items-center space-x-3">
                        <label class="flex-1 cursor-pointer bg-space-800 border border-space-600 rounded-xl px-4 py-3 text-slate-300 hover:border-cyan-accent transition flex items-center justify-between">
                            <span id="file-label" class="text-sm truncate">Choose CSV file...</span>
                            <input type="file" id="csv-file-input" accept=".csv" class="hidden" onchange="handleFileSelect(event)">
                            <svg class="w-5 h-5 text-cyan-accent ml-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                        </label>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <button type="button" onclick="processLocalCSV()" class="px-5 py-2.5 rounded-xl bg-space-700 hover:bg-space-600 border border-space-600 text-cyan-accent font-semibold text-sm transition shadow">
                            Process File Locally
                        </button>
                        <button type="button" onclick="downloadSampleCSV()" class="px-5 py-2.5 rounded-xl bg-space-800 hover:bg-space-700 border border-space-600 text-slate-300 font-semibold text-sm transition">
                            Download CSV Format
                        </button>
                        <button type="button" onclick="clearWearableData()" class="px-5 py-2.5 rounded-xl bg-red-950/40 hover:bg-red-900/50 border border-red-900/50 text-red-300 font-semibold text-sm transition">
                            Clear Loaded Data
                        </button>
                    </div>
                </div>

                <div class="md:col-span-5 bg-space-800 border border-space-700 rounded-xl p-4 text-xs font-mono space-y-2">
                    <div class="text-cyan-accent font-bold uppercase tracking-wider">Required CSV Columns</div>
                    <div class="text-slate-300 bg-space-900 p-2.5 rounded border border-space-700 select-all">
                        timestamp,crew_id,metric,value,unit,source
                    </div>
                    <p class="text-slate-400">Supported metrics: <code class="text-cyan-accent">sleep_hours, heart_rate_bpm, respiratory_rate_bpm, body_temperature_c, personal_co2_ppm, radiation_dose_mSv</code>.</p>
                </div>
            </div>

            <!-- CSV Output Log / Preview Table -->
            <div id="csv-preview-container" class="hidden mt-4 pt-4 border-t border-space-800 space-y-3">
                <div class="text-xs font-mono uppercase text-cyan-accent">Processed Record Preview</div>
                <div class="overflow-x-auto max-h-48 rounded-xl border border-space-700 bg-space-950">
                    <table id="csv-table" class="w-full text-left text-xs font-mono text-slate-300">
                        <thead class="bg-space-800 text-slate-200 border-b border-space-700">
                            <tr>
                                <th class="p-3">Timestamp</th>
                                <th class="p-3">Crew ID</th>
                                <th class="p-3">Metric</th>
                                <th class="p-3">Value</th>
                                <th class="p-3">Unit</th>
                                <th class="p-3">Source</th>
                            </tr>
                        </thead>
                        <tbody id="csv-tbody" class="divide-y divide-space-800">
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Section 04 / User Guide & Workflow Status Definitions -->
        <section class="bg-space-900 border border-space-700 rounded-2xl p-6 shadow-xl space-y-6">
            <div class="flex items-center justify-between border-b border-space-700 pb-4">
                <div class="flex items-center space-x-2">
                    <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-cyan-accent/20 text-cyan-accent font-bold">04</span>
                    <h2 class="text-lg font-bold text-white tracking-wide">USER GUIDE & WORKFLOW DEFINITIONS</h2>
                </div>
                <span class="text-xs text-slate-400 font-mono">MISSION PROTOCOL</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-slate-300">
                <div class="bg-space-800 border border-space-700 rounded-xl p-5 space-y-2">
                    <div class="font-bold text-white">CHECK-IN COMPLETE</div>
                    <p class="text-xs text-slate-400">Means the required self-check fields were completed successfully for the session.</p>
                </div>
                <div class="bg-space-800 border border-space-700 rounded-xl p-5 space-y-2">
                    <div class="font-bold text-amber-warning">TREND TO REVIEW</div>
                    <p class="text-xs text-slate-400">Means imported wearable records contain a descriptive time-series to inspect.</p>
                </div>
                <div class="bg-space-800 border border-space-700 rounded-xl p-5 space-y-2">
                    <div class="font-bold text-red-400">DATA INCOMPLETE</div>
                    <p class="text-xs text-slate-400">Indicates required self-check values or valid files are missing from the current submission.</p>
                </div>
            </div>

            <!-- Disclaimer -->
            <div class="bg-space-950 border border-space-800 rounded-xl p-5 text-xs text-slate-400 space-y-2">
                <div class="font-bold text-slate-300 uppercase tracking-wider">NASA ISS Research Disclaimer</div>
                <p>NASA's ISS research has used wearables to study sleep, heart and breathing patterns, and temperature; separate crew-worn or personal monitors have studied cabin CO₂ and radiation exposure. Those investigations support the relevance of these possible data streams but do not establish a standard upload format or validate AstraVital's analysis. This prototype processes CSV fields using descriptive summaries and does not interpret these signals as a medical diagnosis. NASA has not endorsed AstraVital.</p>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-space-800 mt-12 py-6 text-center text-xs text-slate-500 font-mono">
        AstraVital CHCS Offline Edge Prototype &bull; NASA Space Apps Challenge Submission &bull; Synthetic Data Only
    </footer>

    <!-- Interactive Logic Script -->
    <script>
        // Real-time UTC Clock
        function updateUTCClock() {
            const now = new Date();
            const utcString = now.toUTCString().split(' ')[4] + ' UTC';
            document.getElementById('utc-clock').textContent = utcString;
        }
        setInterval(updateUTCClock, 1000);
        updateUTCClock();

        // State variables
        let checkinDone = false;
        let loadedWearableFile = "None";

        function submitCheckin() {
            const sleep = document.getElementById('sleep-hours').value;
            const fatigue = document.getElementById('fatigue-rating').value;
            const wellbeing = document.querySelector('input[name="wellbeing"]:checked').value;

            checkinDone = true;

            // Update UI Summary
            document.getElementById('summary-sleep').textContent = sleep + " hrs";
            document.getElementById('summary-fatigue').textContent = fatigue + " / 5";
            document.getElementById('summary-wellbeing').textContent = wellbeing + " / 5";

            // Update Status Card
            const card = document.getElementById('status-card');
            const indicator = document.getElementById('status-indicator');
            const text = document.getElementById('status-text');
            const desc = document.getElementById('status-desc');

            card.className = "rounded-xl p-5 border transition-all duration-300 bg-emerald-950/20 border-emerald-500/40";
            indicator.className = "w-3.5 h-3.5 rounded-full bg-emerald-success";
            text.className = "text-xl font-black text-emerald-success tracking-wide";
            text.textContent = loadedWearableFile !== "None" ? "TREND TO REVIEW" : "CHECK-IN COMPLETE";
            desc.textContent = "Daily self-check successfully recorded in local edge state buffer.";
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (file) {
                loadedWearableFile = file.name;
                document.getElementById('file-label').textContent = file.name;
                document.getElementById('summary-wearable').textContent = file.name;
            }
        }

        function processLocalCSV() {
            const fileInput = document.getElementById('csv-file-input');
            const tbody = document.getElementById('csv-tbody');
            tbody.innerHTML = '';

            // Simulated parsed rows for demo if no file or sample data
            const sampleRows = [
                { time: "2026-10-21T06:00:00Z", id: "ASTRO_01_KALEB", metric: "sleep_hours", val: "7.5", unit: "hours", source: "wearable" },
                { time: "2026-10-21T06:00:00Z", id: "ASTRO_01_KALEB", metric: "heart_rate_bpm", val: "62", unit: "bpm", source: "wearable" },
                { time: "2026-10-21T06:00:00Z", id: "ASTRO_01_KALEB", metric: "personal_co2_ppm", val: "410", unit: "ppm", source: "sensor" }
            ];

            sampleRows.forEach(row => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3">${row.time}</td>
                    <td class="p-3">${row.id}</td>
                    <td class="p-3 text-cyan-accent">${row.metric}</td>
                    <td class="p-3 font-bold">${row.val}</td>
                    <td class="p-3">${row.unit}</td>
                    <td class="p-3 text-slate-400">${row.source}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('csv-preview-container').classList.remove('hidden');
            if (loadedWearableFile === "None") {
                loadedWearableFile = "sample_log.csv";
                document.getElementById('summary-wearable').textContent = loadedWearableFile;
            }
            if (checkinDone) {
                document.getElementById('status-text').textContent = "TREND TO REVIEW";
            }
        }

        function downloadSampleCSV() {
            const csvContent = "timestamp,crew_id,metric,value,unit,source\n2026-10-21T06:00:00Z,ASTRO_01_KALEB,sleep_hours,7.5,hours,wearable\n2026-10-21T06:00:00Z,ASTRO_01_KALEB,heart_rate_bpm,62,bpm,wearable";
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "astravital_sample_record.csv";
            link.click();
        }

        function clearWearableData() {
            loadedWearableFile = "None";
            document.getElementById('file-label').textContent = "Choose CSV file...";
            document.getElementById('csv-file-input').value = "";
            document.getElementById('summary-wearable').textContent = "None Loaded";
            document.getElementById('csv-preview-container').classList.add('hidden');
            if (checkinDone) {
                document.getElementById('status-text').textContent = "CHECK-IN COMPLETE";
            }
        }
    </script>
</body>
</html>
